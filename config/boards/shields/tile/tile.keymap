#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1300  
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#include <dt-bindings/zmk/pointing.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define UTIL  3
#define MOUSE 4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <280>; 
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // =================================================================================================================================
        // BASE LAYER
        // =================================================================================================================================
        base_layer {
            bindings = <
            &kp B       &kp L       &kp D         &kp W          &kp Z       &kp SQT  &kp F         &kp O          &kp U           &kp J
            &kp N       &hm LALT R  &kp T         &kp S          &kp G       &kp Y    &kp H         &kp A          &kp E           &kp I
            &hm LGUI Q  &hm RALT X  &hm LCTRL M   &hm LSHFT C    &kp V       &kp K    &hm RSHFT P   &hm RCTRL DOT  &hm RALT MINUS  &hm RGUI COMMA
                                    &lt UTIL ESC  &lt SYM SPACE  &kp TAB     &kp RET  &lt NAV BSPC  &lt MOUSE DEL
            >;
        };

        // =================================================================================================================================
        // NAV LAYER
        // =================================================================================================================================
        nav_layer {
            bindings = <
            &trans    &kp N1  &kp N2  &kp N3  &trans     &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp CAPS
            &trans    &kp N4  &kp N5  &kp N6  &kp N0     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &caps_word
            &kp LGUI  &kp N7  &kp N8  &kp N9  &trans     &kp INS   &kp RSHFT  &kp RCTRL  &kp LALT   &kp RGUI 
                              &trans  &trans  &trans     &trans    &trans     &kp PSCRN
            >;
        };

        // =================================================================================================================================
        // SYM LAYER
        // =================================================================================================================================
        sym_layer {
            bindings = <
            &kp EXCL               &kp AT         &kp HASH        &kp DLLR        &kp PRCNT     &kp CARET  &kp AMPS        &kp STAR        &kp UNDER        &kp QMARK
            &kp LESS_THAN          &kp LBKT       &kp LBRC        &kp LPAR        &kp COLON     &kp SEMI   &kp MINUS       &kp EQUAL       &kp PLUS         &kp SQT
            &hm LGUI GREATER_THAN  &hm LALT RBKT  &hm LCTRL RBRC  &hm LSHFT RPAR  &kp TILDE     &kp GRAVE  &hm RSHFT FSLH  &hm RCTRL PIPE  &hm RALTkp BSLH  &hm RGUI DQT
                                                  &trans          &trans          &trans        &trans     &trans          &trans
            >;
        };

        // =================================================================================================================================
        // UTIL LAYER 
        // =================================================================================================================================
        util_layer {
            bindings = <
            &kp F1        &kp F2        &kp F3         &kp F4        &kp F5           &kp F6        &kp F7        &kp F8      &kp F9        &kp F10
            &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3  &bt BT_SEL 4     &kp C_BRI_UP  &kp C_VOL_DN  &kp K_MUTE  &kp C_VOL_UP  &trans
            &kp F11       &kp F12       &kp LG(LA(L))  &out OUT_BLE  &out OUT_USB     &kp C_BRI_DN  &kp C_PREV    &kp C_PP    &kp C_NEXT    &trans
                                        &trans         &trans        &bt BT_CLR       &trans        &tog NAV      &tog MOUSE
            >;
        };

        // =================================================================================================================================
        // MOUSE LAYER
        // =================================================================================================================================
        mouse_layer {
            bindings = <
            &trans  &trans     &trans      &trans     &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans 
            &trans  &mkp MCLK  &mkp RCLK   &mkp LCLK  &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
            &trans  &trans     &trans      &trans     &trans     &trans          &trans          &trans        &trans           &trans
                               &trans      &trans     &trans     &trans          &trans          &trans
            >;
        };
    };
};
